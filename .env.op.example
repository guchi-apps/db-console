# 1Password CLI 用環境変数ファイル（本番DB確認専用）
#
# 通常のローカル開発（.env.local）には不要。本番の管理対象DB（app_car等）へ
# SSHトンネル経由で接続し、db_console_data/db_console_schema の権限を確認する用途のみで使う。
#
# セットアップ:
#   1. cp .env.op.example .env.op
#   2. op signin
#   3. npm run db:tunnel:prod （このターミナルでトンネルを維持）
#   4. 別ターミナルで mysql -h127.0.0.1 -P3307 -u<db_console_data_user> -p ... のように接続確認

# Vault: apps / Item: Server, githubaction-sshkey（GitHub Actionsデプロイと共通）
SSH_HOST=op://apps/Server/host
SSH_USER=op://apps/Server/username
SSH_PORT=op://apps/Server/ssh-port
SSH_PRIVATE_KEY=op://apps/githubaction-sshkey/private_key?ssh-format=openssh

# 確認対象ロールの認証情報（Vault: apps / Item: db-console）
DB_CONSOLE_DATA_USER=op://apps/db-console/db-console-data-user
DB_CONSOLE_DATA_PASSWORD=op://apps/db-console/db-console-data-password
DB_CONSOLE_SCHEMA_USER=op://apps/db-console/db-console-schema-user
DB_CONSOLE_SCHEMA_PASSWORD=op://apps/db-console/db-console-schema-password
