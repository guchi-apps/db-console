# db-console 自身のメタデータDB（app_db_console）接続情報
# DATABASE_URL は直接設定せず、scripts/construct-database-url.sh で DB_* から組み立てる
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Prisma マイグレーション用（構造変更権限を持つ別ユーザー。任意）
MIGRATE_DB_USER=
MIGRATE_DB_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth.js / Auth.js
AUTH_SECRET=
AUTH_URL=

# ログイン許可メールアドレス（カンマ区切り、複数可）
ALLOWED_EMAILS=

# 管理対象DB（config/databases.yml に列挙されたDB群）は、db-console 自身のDBと
# 同一のMariaDBインスタンスのため、接続先ホスト・ポートは上記 DB_HOST/DB_PORT を共用する。

# 管理対象DBへの通常操作用ロール（SELECT/INSERT/UPDATE/DELETE）
DB_CONSOLE_DATA_USER=
DB_CONSOLE_DATA_PASSWORD=

# 管理対象DBへの構造変更用ロール（+CREATE/ALTER/DROP/INDEX）
DB_CONSOLE_SCHEMA_USER=
DB_CONSOLE_SCHEMA_PASSWORD=

# CI / デプロイ通知（Signaly）
SIGNALY_WEBHOOK_URL=
