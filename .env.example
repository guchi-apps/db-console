# db-console 自身のメタデータDB（app_db_console）接続情報
# DATABASE_URL は直接設定せず、scripts/construct-database-url.sh で DB_* から組み立てる
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Prisma マイグレーション用（構造変更権限を持つ別ユーザー。任意）
MIGRATE_DB_USER=
MIGRATE_DB_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth.js / Auth.js
AUTH_SECRET=
AUTH_URL=

# ログイン許可メールアドレス（カンマ区切り、複数可）
ALLOWED_EMAILS=

# 管理対象DB（設定画面に登録したDB群）は、db-console 自身のDBと同一のMariaDB
# インスタンスのため、通常は接続先ホスト・ポートに上記 DB_HOST/DB_PORT を共用する。
# ローカル開発からSSHトンネル経由で本番データを参照する場合など、管理対象DBの
# 接続先だけを変えたいときは以下を設定する（任意、通常は空のままでよい）。
TARGET_DB_HOST=
TARGET_DB_PORT=

# 管理対象DBへの通常操作用ロール（SELECT/INSERT/UPDATE/DELETE）
DB_CONSOLE_DATA_USER=
DB_CONSOLE_DATA_PASSWORD=

# 管理対象DBへの構造変更用ロール（+CREATE/ALTER/DROP/INDEX）
DB_CONSOLE_SCHEMA_USER=
DB_CONSOLE_SCHEMA_PASSWORD=

# CI / デプロイ通知（Signaly）
SIGNALY_WEBHOOK_URL=
