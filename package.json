{
  "name": "db-console",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "version": "node scripts/version-changelog.mjs",
    "dev": "bash -c 'set -a; [ -f .env.local ] && source .env.local; set +a; bash scripts/construct-database-url.sh next dev'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "env:init": "cp -n .env.example .env.local && echo 'Created .env.local (edit values, then: npm run db:setup && npm run db:migrate && npm run dev)'",
    "db:setup": "bash scripts/setup-db.sh",
    "db:migrate": "bash -c 'set -a; source .env.local; set +a; export CHECKPOINT_DISABLE=1; bash scripts/construct-database-url.sh npx prisma migrate dev'",
    "db:tunnel:prod": "bash scripts/prod-db-tunnel.sh",
    "dev:prod-db": "bash scripts/dev-prod-db.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-mariadb": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "mysql2": "^3.23.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "prisma": "^7.9.0",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "prisma@7.9.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
